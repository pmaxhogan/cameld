# cameld configuration. Copy to .env and fill in. .env is gitignored; this repo
# is public, so never commit real values. Real secrets live only on the host.
# Blank values fall back to the defaults documented in server/src/config.ts.

# Strava API application (create a dedicated one for cameld)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# First run only: seed refresh token. The rotated token is stored in SQLite afterwards.
STRAVA_REFRESH_TOKEN=

# strava.com web session used for hide/delete/export
STRAVA_WEB_EMAIL=
STRAVA_WEB_PASSWORD=

# Root of the data volume; state/ is created underneath it
DATA_DIR=
# Public origin the UI is served on, e.g. https://cameld.example.com
PUBLIC_URL=

# Cloudflare Access (verified server side)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
ALLOWED_EMAIL=

# Secondary backup password (hash only) and session cookie signing key
UI_PASSWORD_HASH=
SESSION_SECRET=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Host-side ZFS snapshot helper (deploy/snapshot-helper/, docs/ARCHITECTURE.md)
SNAPSHOT_HELPER_URL=
SNAPSHOT_HELPER_TOKEN=

# Email-code relay Worker (relay/), which receives forwarded Strava login codes
RELAY_URL=
RELAY_TOKEN=

# DevTools endpoint of the cameld-browser sidecar, e.g. http://cameld-browser:9222
BROWSER_CDP_URL=

# fatal | error | warn | info | debug | trace | silent. Default info.
LOG_LEVEL=
