# cameld configuration. Copy to .env and fill in. .env is gitignored; this repo
# is public, so never commit real values. Real secrets live only on the host.
# Blank values fall back to the defaults documented in server/src/config.ts.

# Strava API application (create a dedicated one for cameld)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# First run only: seed refresh token. The rotated token is stored in SQLite afterwards.
STRAVA_REFRESH_TOKEN=

# strava.com web session used for hide/delete/export
STRAVA_WEB_EMAIL=
STRAVA_WEB_PASSWORD=

# Root of the data volume; state/ is created underneath it
DATA_DIR=
# Public origin the UI is served on, e.g. https://cameld.example.com. State-changing
# requests must come from this origin (or carry the UI's CSRF header).
PUBLIC_URL=

# Cloudflare Access, verified server side on every request (RS256 against the team's
# keys; iss, aud, exp and the email claim, which must equal ALLOWED_EMAIL).
# Team domain e.g. yourteam.cloudflareaccess.com; the AUD tag is on the Access app.
# (A plain http://127.0.0.1 team domain is accepted for the e2e test double only.)
# Without all five auth values below, every UI and /api request is refused.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
ALLOWED_EMAIL=

# Secondary backup password, hash only: node scripts/hash-password.ts prints a new
# password and its hash (or hashes one piped on stdin). Never pass it as an argument.
UI_PASSWORD_HASH=
# Session cookie signing key, at least 32 characters, e.g. openssl rand -hex 32.
# Rotating it (or the password hash) signs every session out.
SESSION_SECRET=

# Web Push (off when unset). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for the push services
VAPID_SUBJECT=

# MapLibre style for the review maps. Default: OpenFreeMap "liberty" (no key needed).
# "none" draws the tracks on a blank canvas.
MAP_STYLE_URL=

# Host-side ZFS snapshot helper (deploy/snapshot-helper/, docs/ARCHITECTURE.md)
SNAPSHOT_HELPER_URL=
SNAPSHOT_HELPER_TOKEN=

# Email-code relay Worker (relay/), which receives forwarded Strava login codes
RELAY_URL=
RELAY_TOKEN=

# DevTools endpoint of the cameld-browser sidecar, e.g. http://cameld-browser:9222
BROWSER_CDP_URL=
# KasmVNC web client of the same sidecar, proxied same-origin at /browser/ for the
# "Strava login" panel, e.g. https://cameld-browser:6901 (plain http: loopback only).
# Its basic-auth credentials are injected server side and never reach the browser.
BROWSER_VNC_URL=
BROWSER_VNC_USER=
BROWSER_VNC_PASSWORD=
# PEM file of the sidecar's self-signed certificate: the ONLY trust anchor for that
# upstream. Required for https. Export it with:
#   openssl s_client -connect cameld-browser:6901 </dev/null | openssl x509 > vnc.pem
BROWSER_VNC_CA_FILE=
# Optional SHA-256 pin of that certificate (hex, colons allowed). When set it
# replaces the host name check:
#   openssl x509 -in vnc.pem -noout -fingerprint -sha256
BROWSER_VNC_CERT_SHA256=

# fatal | error | warn | info | debug | trace | silent. Default info.
LOG_LEVEL=
